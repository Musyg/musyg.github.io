{
  "name": "musyg.github.io",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "packageManager": "npm@11.6.0",
  "scripts": {
    "dev": "vite --host 127.0.0.1",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "lint": "oxlint",
    "typecheck": "tsc -b",
    "content:check": "node scripts/check-content.mjs",
    "test": "vitest run && node --test tests/server/contact.test.mjs",
    "test:server": "node --test tests/server/*.test.mjs",
    "start": "node server/index.mjs",
    "test:watch": "vitest",
    "build:client": "vite build",
    "build:ssr": "vite build --ssr src/entry-server.tsx --outDir dist-ssr",
    "prerender": "node scripts/prerender.mjs",
    "build": "npm run audit:dependencies && npm run typecheck && npm run content:check && npm run build:client && npm run build:ssr && npm run prerender && npm run package:release",
    "package:release": "node scripts/package-release.mjs",
    "build:release": "npm run build",
    "test:release": "node --test tests/release/*.test.mjs",
    "test:deployment": "node --test tests/deployment/*.test.mjs",
    "preview": "vite preview --host 127.0.0.1",
    "test:e2e": "playwright test --grep-invert @a11y",
    "test:a11y": "playwright test --grep @a11y",
    "audit:dependencies": "npm audit --audit-level=low --include=dev",
    "verify": "npm run audit:dependencies && npm run format:check && npm run lint && npm run typecheck && npm run content:check && npm test && npm run build && npm run test:server && npm run test:release && npm run test:deployment && npm run test:e2e && npm run test:a11y"
  },
  "dependencies": {
    "nodemailer": "10.2.1",
    "react": "^19.3.1",
    "react-dom": "^19.3.1"
  },
  "devDependencies": {
    "@axe-core/playwright": "4.14.0",
    "@playwright/test": "1.64.1",
    "@testing-library/jest-dom": "^7.0.1",
    "@testing-library/react": "16.3.3",
    "@types/node": "^24.19.2",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^6.1.2",
    "jsdom": "30.1.3",
    "oxlint": "^1.90.0",
    "prettier": "3.9.10",
    "typescript": "~7.0.2",
    "vite": "8.3.5",
    "vitest": "5.0.5"
  }
}
